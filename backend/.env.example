# Copy this file to .env and fill in real values. Never commit .env or service-account.json.

GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GCS_BUCKET_DEV=contentshield-videos-dev
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GEMINI_ANALYSIS_MODEL=gemini-2.0-flash-001
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_VIDEO_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_LOCATION=global
VIDEO_SEGMENT_SECONDS=5
# Optional absolute paths when FFmpeg/FFprobe are not on PATH.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MAX_UPLOAD_BYTES=52428800
MAX_VIDEO_SECONDS=90
SIGNED_URL_MINUTES=15
